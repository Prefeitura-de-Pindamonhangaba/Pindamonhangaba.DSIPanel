NODE_ENV=development
APP_URL=https://localhost:3000
# Endereço do host onde o Docker publica a aplicação (0.0.0.0 libera a rede).
APP_BIND_ADDRESS=0.0.0.0
# Porta publicada no host. O container continua usando 3000 internamente.
APP_PORT=3000
APP_CPUS=1.0
APP_MEMORY_LIMIT=768m
PROXY_CPUS=0.5
PROXY_MEMORY_LIMIT=128m
DATABASE_URL=postgresql://dsi_panel:local_password@localhost:5432/dsi_panel
POSTGRES_USER=dsi_panel
POSTGRES_PASSWORD=local_password
POSTGRES_DB=dsi_panel
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=512m

# Login institucional (preencher nesta instalação)
BETTER_AUTH_SECRET=
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# CA pública do Keycloak, quando necessária; caminho dentro do container.
# Exemplo: /certificates/keycloak-ca.pem
NODE_EXTRA_CA_CERTS=

# Integração GLPI: utilizar conta de serviço autorizada com acesso de leitura
GLPI_API_URL=https://glpi.pindamonhangaba.sp.gov.br/apirest.php/
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
# Opcional; vazio permite localizar o grupo com nome exato DSI
GLPI_DSI_GROUP_ID=
GLPI_TIME_ZONE=America/Sao_Paulo

# Somente localhost: ignora o login para navegação de teste, sem escrita.
AUTH_BYPASS_ENABLED=false

APP_BIND_ADDRESS=10.0.0.193
APP_PORT=3004
APP_IMAGE=dsi-panel:production
APP_CPUS=1.0
APP_MEMORY_LIMIT=512m
PROXY_NETWORK=nginx-proxy-manager_default

{
  "name": "dsi-panel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --bun next dev --hostname 127.0.0.1",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start --hostname 0.0.0.0",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "test:e2e": "bunx --bun playwright test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "drizzle-kit": "0.31.11",
    "@playwright/test": "1.64.1"
  }
}


